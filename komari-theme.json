{
  "name": "Endfield / 终末地",
  "short": "Endfield",
  "description": "终末地风格监控主题，支持深浅外观、节点状态环、交互地球与主机信息卡片。",
  "version": "1.5.0",
  "author": "Endfield Theme",
  "url": "https://github.com/BakaNoble/komari-endfield-theme",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "Endfield 外观设置",
    "data": [
      { "name": "内容与外观", "type": "title" },
      { "key": "headline", "name": "概览标题", "type": "string", "default": "节点总览" },
      { "key": "accent", "name": "强调色", "type": "select", "options": "yellow,ice,amber,lime", "default": "yellow" },
      { "key": "default_theme", "name": "默认主题", "type": "select", "options": "light,dark,system", "default": "light" },
      { "key": "density", "name": "列表密度", "type": "select", "options": "standard,compact", "default": "standard" },
      { "key": "overview_node_view", "name": "总览主机显示", "type": "select", "options": "list,cards", "default": "list" },
      { "key": "nodes_node_view", "name": "节点主机显示", "type": "select", "options": "list,cards", "default": "list" },
      { "key": "network_node_view", "name": "网络主机显示", "type": "select", "options": "list,cards", "default": "list" },
      { "key": "tilt_scope", "name": "动效响应范围", "type": "select", "options": "仅组件,整个页面", "default": "仅组件" },
      { "name": "交互地球", "type": "title" },
      { "key": "globe_traffic", "name": "节点流量特效", "type": "select", "options": "开启,关闭", "default": "开启" },
      { "key": "globe_traffic_concurrent", "name": "多台并发", "type": "select", "options": "开启,关闭", "default": "关闭" },
      { "key": "globe_traffic_interval", "name": "流量发送间隔下限（秒，2–30）", "type": "number", "default": 6 },
      { "name": "监控设置", "type": "title" },
      { "key": "refresh_interval", "name": "更新间隔（秒）", "type": "number", "default": 2 },
      { "key": "warning_threshold", "name": "资源提醒阈值（%）", "type": "number", "default": 85 }
    ]
  }
}
